{
  "name": "@yuanhhou/ds",
  "version": "0.4.0",
  "type": "module",
  "description": "yuanhhou design system for React: components and tokens from the Figma DS.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k619tw/yuanhhou-design-system.git",
    "directory": "web"
  },
  "homepage": "https://github.com/k619tw/yuanhhou-design-system#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib"
  ],
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./style.css": "./lib/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "rm -rf lib && tsc -p tsconfig.lib.json && vite build -c vite.lib.config.ts",
    "prepack": "npm run build:lib",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
