    "Summary" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まとめ"
          }
        }
      }
    },
    "SwiftUI has no checkbox or radio control. Use a switch for a setting that applies at once, a Picker to choose one option, and a list with checkmarks to choose several. Selection is always a binding: a single value for one, a Set for many." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SwiftUI にはチェックボックスもラジオボタンもありません。すぐ反映される設定にはスイッチ、1つ選ぶには Picker、複数選ぶにはチェックマーク付きリストを使います。選択は常にバインディングで、1つなら単一の値、複数なら Set です。"
          }
        }
      }
    },
    "System" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム"
